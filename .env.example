# AETHER-HUD Environment Variables
# Copy this to .env and fill in your values

# Site URL (used for SEO/meta)
NEXT_PUBLIC_SITE_URL=https://aether-hud-lyart.vercel.app

# Portfolio Name
NEXT_PUBLIC_PORTFOLIO_NAME=Bahrul Ulumul Haq

# Portfolio Tagline
NEXT_PUBLIC_PORTFOLIO_TAGLINE=Full-Stack Developer & AI Engineer

# PostgreSQL connection string (Prisma). No default — required for DB features.
# Example: postgresql://USER:PASSWORD@HOST:5432/aether_hud
DATABASE_URL=

# Dashboard admin password (auth/route.ts). No default — auth fails closed
# (HTTP 503) when unset. Generate with: openssl rand -base64 24
DASHBOARD_SECRET=12345
