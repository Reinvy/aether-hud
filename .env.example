# PostgreSQL Database Connection URL
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
#
# Leave this UNCOMMENTED only when credentials exist. With DATABASE_URL
# absent the codex runs in static-data mode: every read is served from
# src/data/portfolio.ts + src/data/sections.ts, and write endpoints answer
# 503. Uncomment, then run `npx prisma migrate deploy`.
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aether_hud?schema=public"

# Dashboard Authentication Secret (Codex Console password).
# Unset → the console fails closed (503) instead of accepting a default.
DASHBOARD_SECRET=""
# generate with: openssl rand -hex 32

# Public Application URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Custom Portfolio Profile Defaults
NEXT_PUBLIC_PORTFOLIO_NAME="Bahrul Ulumul Haq"
NEXT_PUBLIC_PORTFOLIO_TAGLINE="Full-Stack Developer & AI Engineer"
